#: lib/peggy_web/live/farm_live/settings.ex:152
#, elixir-autogen, elixir-format
msgid "Default 114. Drives expected farrow date and due-window filters."
msgstr "Lalai 114. Memacu tarikh beranak dijangka dan penapis tetingkap tempoh."

#: lib/peggy_web/live/farm_live/settings.ex:264
#, elixir-autogen, elixir-format
msgid "Default 120. Grower batches older than this are flagged for promotion."
msgstr "Lalai 120. Kumpulan babi membesar lebih tua daripada ini ditanda untuk naik taraf."

#: lib/peggy_web/live/farm_live/settings.ex:277
#, elixir-autogen, elixir-format
msgid "Default 200. Finisher batches still on farm past this age are flagged for departure (sale / slaughter)."
msgstr "Lalai 200. Kumpulan babi akhir yang masih di ladang melepasi umur ini ditanda untuk keluar (jualan / sembelihan)."

#: lib/peggy_web/live/farm_live/settings.ex:193
#, elixir-autogen, elixir-format
msgid "Default 21. Lactating sows older than this trigger a “wean due” task."
msgstr "Lalai 21. Babi ibu menyusu lebih tua daripada ini mencetuskan tugasan “cerai susu tiba tempoh”."

#: lib/peggy_web/live/farm_live/settings.ex:180
#, elixir-autogen, elixir-format
msgid "Default 24. Used to back-fill farrow date when only a wean date is known."
msgstr "Lalai 24. Digunakan untuk mengisi semula tarikh beranak apabila hanya tarikh cerai susu diketahui."

#: lib/peggy_web/live/farm_live/settings.ex:165
#, elixir-autogen, elixir-format
msgid "Default 3. Farrowing must land within ±this many days of served_at + gestation."
msgstr "Lalai 3. Beranak mesti jatuh dalam ±sebanyak hari ini dari served_at + kebuntingan."

#: lib/peggy_web/live/farm_live/settings.ex:206
#, elixir-autogen, elixir-format
msgid "Default 365. DOB offset for back-filled (inferred) sows."
msgstr "Lalai 365. Ofset tarikh lahir untuk babi ibu diisi semula (disimpulkan)."

#: lib/peggy_web/live/farm_live/settings.ex:234
#, elixir-autogen, elixir-format
msgid "Default 60. How far back the weaning form's batch picker looks when suggesting pools to consolidate into."
msgstr "Lalai 60. Sejauh mana ke belakang pemilih kumpulan borang cerai susu melihat apabila mencadangkan kumpulan untuk digabungkan."

#: lib/peggy_web/live/farm_live/settings.ex:219
#, elixir-autogen, elixir-format
msgid "Default 7. Re-services within this window collapse into the prior service event instead of creating a new row."
msgstr "Lalai 7. Kawin semula dalam tetingkap ini bergabung ke acara kawin terdahulu dan bukannya mencipta baris baharu."

#: lib/peggy_web/live/farm_live/settings.ex:249
#, elixir-autogen, elixir-format
msgid "Default 70. Weaner batches older than this surface in the “Promote batch animals” triage screen."
msgstr "Lalai 70. Kumpulan babi cerai susu lebih tua daripada ini muncul dalam skrin triaj “Naik taraf ternakan kumpulan”."

#: lib/peggy_web/live/farm_live/breeding/gestating.ex:319
#, elixir-autogen, elixir-format
msgid "Defaults to female sow, status open, DOB = served_at − 1 year. Marked needs-review."
msgstr "Lalai kepada babi ibu betina, status belum bunting, tarikh lahir = served_at − 1 tahun. Ditanda perlu semakan."

